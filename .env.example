# NITS Arena – Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# ------------------------------------------------------------------
# Discord Bot
# ------------------------------------------------------------------
DISCORD_TOKEN=your_discord_bot_token_here

# ------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------
# Option A: full connection URL (recommended)
DATABASE_URL=postgresql+asyncpg://nitsarena:changeme@localhost:5432/nitsarena

# Option B: individual components (used when DATABASE_URL is not set)
POSTGRES_USER=nitsarena
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nitsarena

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
# Set to DEBUG for verbose output, INFO for production
LOG_LEVEL=INFO
